BOT_TOKEN=123456:ABC...
# Ma'lumotlar bazasi bo'ladigan kanal (bot admin bo'lsin: Post, Edit messages of others (pin uchun), Delete messages of others). ID: -100xxxxxxxxxx
DB_CHANNEL_ID=-1001234567890
SUPERADMIN_IDS=111111111
# Tekshiruv manbalari tartibi: apify | probe | probe,apify
CHECKERS=apify
APIFY_TOKEN=
APIFY_ACTOR=sync-network/username-availability-checker
# Oyiga Apify'da sarflashga ruxsat etilgan natijalar soni (bepul kredit tugab qolmasin)
APIFY_MONTHLY_BUDGET=8000
# Apify aktori tezligi: sekinroq = Instagram kamroq bloklaydi. APIFY_PROXY=true Apify proxy'ni yoqadi (kredit ketishi mumkin)
APIFY_CONCURRENCY=3
APIFY_DELAY=1.5
APIFY_PROXY=false
# probe uchun (ixtiyoriy): har qatorda bitta proxy
PROXIES_FILE=proxies.txt
MAX_CHECKS=3000
CHUNK_SIZE=40
PRESET_LIMIT=6
REQUIRE_EACH_TYPE=1
# bAI (VIP) uchun istalgan OpenAI-compatible endpoint
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ROUNDS=3
PORT=10000
# Render deploy paytida eski nusxa snapshotni yozib bo'lishini kutish (soniya)
STARTUP_GRACE=20
